PORT=3000
# MySQL/MariaDB database (cPanel → MySQL Databases). The app starts without
# it, but /health reports "not configured" until all of these are set.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Encrypts the authenticator secret stored in the database. At least 32
# characters; make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it: if it changes, run `npm run create-user -- --reset-2fa` and set up
# the authenticator app again.
ENCRYPTION_KEY=
